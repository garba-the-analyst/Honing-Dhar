; ==============================================================================
; DHAR COMPILER - Simplified Pipeline Orchestrator
; ==============================================================================

pull "lexer"
pull "parser"
pull "symbol"
pull "codegen"

task compile_source(source: str, len: i32) -> i32:
    lock msg: str = "=== Compiling ===\n"
    sys 1, 1, msg, 16
    
    lock lmsg: str = "[1/4] Lexical Analysis...\n"
    sys 1, 1, lmsg, 24
    flux tokens: i32 = 0
    flux tok_count: i32
    tok_count = len / 4
    lock tmsg: str = "    Tokens: "
    sys 1, 1, tmsg, 10
    sys 1, 2, tok_count, 1
    lock nl: str = "\n"
    sys 1, 1, nl, 1
    
    lock pmsg: str = "[2/4] Parsing...\n"
    sys 1, 1, pmsg, 17
    flux ast: i32 = 1
    lock pmsg2: str = "    AST: OK\n"
    sys 1, 1, pmsg2, 11
    
    lock smsg: str = "[3/4] Symbol Resolution...\n"
    sys 1, 1, smsg, 25
    flux st: i32 = 0
    lock smsg2: str = "    Symbols: 0\n"
    sys 1, 1, smsg2, 13
    
    lock cmsg: str = "[4/4] Code Generation...\n"
    sys 1, 1, cmsg, 24
    lock cmsg2: str = "    Generated\n"
    sys 1, 1, cmsg2, 12
    
    lock dmsg: str = "=== Done ===\n"
    sys 1, 1, dmsg, 13
    give 0

task core():
    lock msg: str = "Compiler loaded\n"
    sys 1, 1, msg, 16