task lookup_symbol(name: i32):
    give 0

task infer_flux_for_assign(is_declared: i32, val: i32):
    when is_declared == 0:
        lock m: str = "  infer: x=5 -> flux x:i32 = 5\n"
        sys 1, 1, m, 27
        give 1
    give 0

task desugar_task_header(has_task: i32):
    when has_task == 0:
        lock m: str = "  infer: foo(a,b): -> task foo(a:i32,b:i32):\n"
        sys 1, 1, m, 38
        give 1
    give 0

task core():
    lock msg: str = "parser: inference ready\n"
    sys 1, 1, msg, 24
    infer_flux_for_assign(0, 5)
    desugar_task_header(0)
