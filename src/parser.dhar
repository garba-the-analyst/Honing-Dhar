task is_digit(c: i32):
    when c >= 48:
        when c <= 57:
            give 1
    give 0

task infer_and_emit_var(name: i32, val: i32):
    lock msg: str = "  emit: flux x:i32 = val\n"
    sys 1, 1, msg, 24
    give 1

task handle_concise_assign(is_declared: i32, val: i32):
    when is_declared == 0:
        lock m1: str = "infer flux x:i32\n"
        sys 1, 1, m1, 18
        give 1
    give 0

task handle_plus_eq(target: i32, delta: i32):
    flux tmp: i32 = 0
    tmp = target + delta
    lock msg: str = "desugar x+=1\n"
    sys 1, 1, msg, 15
    give tmp

task core():
    lock a: str = "parser: x=5 inferred\n"
    sys 1, 1, a, 22
    handle_concise_assign(0, 5)
    handle_plus_eq(5, 1)
