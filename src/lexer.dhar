task read_file_into_buf(path: str):
    flux fd: i32 = 0
    sys 2, path, 0, 0
    sysret fd
    flux buf: raw[4096]
    flux n: i32 = 0
    sys 0, fd, buf, 4096
    sysret n
    sys 3, fd, 0, 0
    give n

task each_file_iter(path: str):
    flux len: i32 = 0
    len = read_file_into_buf(path)
    lock m1: str = "  ; each y in file buf\n"
    sys 1, 1, m1, 22
    flux idx: i32 = 0
    span idx < len:
        flux y: i32 = 0
        peek y, path, idx
        idx = idx + 1
    give len

task core():
    lock msg: str = "lexer: each file iteration ready\n"
    sys 1, 1, msg, 32
    each_file_iter(msg)
