task read_source(path: str):
    flux fd: i32 = 0
    sys 2, path, 0, 0
    sysret fd
    flux buf: raw[4096]
    flux n: i32 = 0
    sys 0, fd, buf, 4096
    sysret n
    sys 3, fd, 0, 0
    give n

task tokenize_each(line: i32):
    lock m1: str = "  lex: each y in buf -> y, in, buf\n"
    sys 1, 1, m1, 31
    give line

task handle_file_iter(path: str):
    flux n: i32 = 0
    n = read_source(path)
    tokenize_each(n)
    give n

task core():
    lock msg: str = "lexer: file I/O for each y in buf\n"
    sys 1, 1, msg, 32
    handle_file_iter(msg)
