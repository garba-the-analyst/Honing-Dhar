task is_space(c: i32):
    when c == 32:
        give 1
    when c == 9:
        give 1
    give 0

task is_newline(c: i32):
    when c == 10:
        give 1
    when c == 13:
        give 1
    give 0

task is_alpha(c: i32):
    when c >= 65:
        when c <= 90:
            give 1
    when c >= 97:
        when c <= 122:
            give 1
    give 0

task is_digit(c: i32):
    when c >= 48:
        when c <= 57:
            give 1
    give 0

task handle_concise_token(c: i32):
    lock msg: str = "lex: concise x=5, x+=1, choose/is\n"
    sys 1, 1, msg, 30
    give c

task core():
    lock a: str = "Stage 1 lexer: file I/O + concise\n"
    sys 1, 1, a, 32
    flux buf: raw[256]
    handle_concise_token(43)
