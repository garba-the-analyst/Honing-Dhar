task is_alpha(c: i32):
    when c >= 65:
        when c <= 90:
            give 1
        fallback:
            when c >= 97:
                when c <= 122:
                    give 1
    give 0

task is_digit(c: i32):
    when c >= 48:
        when c <= 57:
            give 1
    give 0

task is_alnum(c: i32):
    flux a: i32 = 0
    a = is_alpha(c)
    when a == 1:
        give 1
    a = is_digit(c)
    give a

task core():
    lock msg: str = "Stage 1 lexer ready\n"
    sys 1, 1, msg, 19
