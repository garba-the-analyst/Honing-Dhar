task read_source(path: str):
    flux fd: i32 = 0
    sys 2, path, 0, 0
    sysret fd
    flux buf: raw[4096]
    flux n: i32 = 0
    sys 0, fd, buf, 4096
    sysret n
    sys 3, fd, 0, 0
    give n

task is_space(c: i32):
    when c == 32:
        give 1
    when c == 9:
        give 1
    give 0

task tokenize_concise(c: i32):
    when c == 43:
        give 1
    give 0

task core():
    lock msg: str = "lexer: file I/O + x=5, x+=1 tokenized\n"
    sys 1, 1, msg, 33
    flux n: i32 = 0
    n = read_source(msg)
    tokenize_concise(43)
