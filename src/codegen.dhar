task emit_match_header(val: i32):
    lock ma1: str = "  ; match x: pattern\n"
    sys 1, 1, ma1, 20
    lock ma2: str = "  mov r12, x\n"
    sys 1, 1, ma2, 13
    give val

task emit_match_is(val: i32):
    lock mi1: str = "  cmp r12, 1\n"
    sys 1, 1, mi1, 13
    lock mi2: str = "  je .L_match_arm\n"
    sys 1, 1, mi2, 17
    give val

task emit_repeat_start():
    lock rp1: str = ".L_repeat_start:\n"
    sys 1, 1, rp1, 16
    give 0

task emit_repeat_until(cond: i32):
    lock ru1: str = "  cmp r12, 10\n"
    sys 1, 1, ru1, 14
    lock ru2: str = "  jl .L_repeat_start\n"
    sys 1, 1, ru2, 19
    give cond

task emit_raise(err: i32):
    lock ra1: str = "  ; raise err -> rescue\n"
    sys 1, 1, ra1, 24
    lock ra2: str = "  jmp rescue_landing\n"
    sys 1, 1, ra2, 21
    give err

task core():
    lock msg: str = "codegen: match/repeat/raise wired\n"
    sys 1, 1, msg, 32
    emit_match_header(1)
    emit_match_is(1)
    emit_repeat_start()
    emit_repeat_until(10)
    emit_raise(42)
