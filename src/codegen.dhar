; ==============================================================================
; DHAR CODEGEN - No string concatenation
; ==============================================================================

task cg_emit(text: str):
    sys 1, 1, text, text.len

task cg_emitln(text: str):
    cg_emit(text)
    cg_emit("\n")

task cg_prologue(name: str):
    cg_emitln(name)
    cg_emitln(":")
    cg_emitln("    push rbp")
    cg_emitln("    mov rbp, rsp")

task cg_epilogue():
    cg_emitln("    mov rsp, rbp")
    cg_emitln("    pop rbp")
    cg_emitln("    ret")

task cg_load_const(v: i32):
    lock s1: str = "    mov rax, "
    cg_emit(s1)
    sys 1, 2, v, 1
    cg_emit("\n")

task cg_load_var(offset: i32):
    lock s1: str = "    mov rax, [rbp-"
    cg_emit(s1)
    sys 1, 2, offset, 1
    cg_emit("]\n")

task cg_store_var(offset: i32):
    lock s1: str = "    mov [rbp-"
    cg_emit(s1)
    sys 1, 2, offset, 1
    cg_emit("], rax\n")

task cg_jump(label: i32):
    lock s1: str = "    jmp .L"
    cg_emit(s1)
    sys 1, 2, label, 1
    cg_emit("\n")

task cg_label(label: i32):
    lock s1: str = ".L"
    cg_emit(s1)
    sys 1, 2, label, 1
    cg_emit(":\n")

task cg_call(name: str):
    lock s1: str = "    call "
    cg_emit(s1)
    cg_emit(name)
    cg_emit("\n")

task cg_gen_string(msg: str):
    cg_emitln("    mov rax, 1")
    cg_emitln("    mov rdi, 1")
    lock s1: str = "    mov rsi, "
    cg_emit(s1)
    cg_emit(msg)
    cg_emit("\n")
    lock s2: str = "    mov rdx, "
    cg_emit(s2)
    sys 1, 2, msg.len, 1
    cg_emit("\n")
    cg_emitln("    syscall")

task core():
    lock msg: str = "Codegen loaded\n"
    sys 1, 1, msg, 15