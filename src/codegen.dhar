task should_keep_in_reg(use_count: i32):
    when use_count >= 5:
        give 1
    give 0

task emit_choose_subject(val: i32):
    lock c1: str = "  ; choose x: subject in r12\n"
    sys 1, 1, c1, 26
    give val

task emit_is_branch(val: i32):
    lock i1: str = "  cmp r12, 1\n"
    sys 1, 1, i1, 13
    lock i2: str = "  jne next_is\n"
    sys 1, 1, i2, 14
    give val

task emit_attempt_handler():
    lock a1: str = "  ; attempt: push handler\n"
    sys 1, 1, a1, 25
    give 0

task emit_rescue_handler(err: i32):
    lock r1: str = "  rescue: landing pad\n"
    sys 1, 1, r1, 22
    give err

task core():
    lock msg: str = "codegen: choose/is -> cmp/jne, attempt/rescue landing pads\n"
    sys 1, 1, msg, 55
    emit_choose_subject(1)
    emit_is_branch(1)
    emit_attempt_handler()
    emit_rescue_handler(0)
