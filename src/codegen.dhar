task emit_each_with_peek(buf_len: i32):
    lock e1: str = "  ; each y in buf: peek\n"
    sys 1, 1, e1, 22
    lock e2: str = "  xor r13, r13\n"
    sys 1, 1, e2, 15
    lock e3: str = ".L_each_peek:\n"
    sys 1, 1, e3, 14
    lock e4: str = "  cmp r13, len\n"
    sys 1, 1, e4, 15
    lock e5: str = "  jge .L_each_done\n"
    sys 1, 1, e5, 17
    lock e6: str = "  mov r12b, [buf+r13]\n"
    sys 1, 1, e6, 21
    give buf_len

task emit_attempt_real():
    lock a1: str = "  ; attempt push\n"
    sys 1, 1, a1, 17
    lock a2: str = "  push rescue\n"
    sys 1, 1, a2, 14
    give 0

task emit_rescue_real(err: i32):
    lock r1: str = "rescue_landing:\n"
    sys 1, 1, r1, 16
    give err

task emit_ensure_real():
    lock e1: str = "ensure_landing:\n"
    sys 1, 1, e1, 16
    give 0

task core():
    lock msg: str = "codegen: each->peek, attempt pads\n"
    sys 1, 1, msg, 34
    emit_each_with_peek(10)
    emit_attempt_real()
    emit_rescue_real(0)
    emit_ensure_real()
