task emit_ensure_always():
    lock e1: str = "ensure_landing:\n"
    sys 1, 1, e1, 16
    lock e2: str = "  ; always runs\n"
    sys 1, 1, e2, 15
    lock e3: str = "  pop handler\n"
    sys 1, 1, e3, 14
    lock e4: str = "  ret\n"
    sys 1, 1, e4, 6
    give 0

task emit_attempt_with_ensure():
    lock a1: str = "  push ensure_addr\n"
    sys 1, 1, a1, 19
    give 0

task core():
    lock msg: str = "codegen: ensure always runs\n"
    sys 1, 1, msg, 28
    emit_attempt_with_ensure()
    emit_ensure_always()
