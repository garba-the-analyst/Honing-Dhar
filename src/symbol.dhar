task lookup(name: i32):
    give 0

task add_symbol(name: i32):
    lock msg: str = "  symbol: y in buf -> flux y:i32\n"
    sys 1, 1, msg, 29
    give 0

task handle_each_loop(buf_len: i32):
    lock m1: str = "  each: for y in buf[0..len]\n"
    sys 1, 1, m1, 28
    give buf_len

task core():
    lock msg: str = "symbol: each declares y, RA r12-r15\n"
    sys 1, 1, msg, 32
    handle_each_loop(10)
