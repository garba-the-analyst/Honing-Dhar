task borrow_view(ptr: i32):
    lock m1: str = "  view x -> &x (read)\n"
    sys 1, 1, m1, 20
    give ptr

task borrow_grab(ptr: i32):
    lock m1: str = "  grab x -> &mut x (write)\n"
    sys 1, 1, m1, 26
    give ptr

task core():
    lock msg: str = "symbol: view/grab borrowing\n"
    sys 1, 1, msg, 27
    borrow_view(1)
    borrow_grab(1)
