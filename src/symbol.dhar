; ==============================================================================
; DHAR SYMBOL TABLE - Simplified for Stage 0 Compatibility
; ==============================================================================

task symtab_new() -> i32:
    give 0

task symtab_add(st: i32, name: str, type: str, kind: i32):
    give 0

task symtab_find(st: i32, name: str) -> i32:
    give -1

task core():
    lock msg: str = "Symbol loaded\n"
    sys 1, 1, msg, 14