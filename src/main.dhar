task emit_header():
    lock h1: str = "section .text\n"
    sys 1, 1, h1, 14
    lock h2: str = "  global _start\n"
    sys 1, 1, h2, 16
    lock h3: str = "_start:\n  call core\n"
    sys 1, 1, h3, 18

task emit_inferred_var(val: i32):
    lock m1: str = "  ; inferred: y=10 -> flux y:i32=10\n"
    sys 1, 1, m1, 31
    lock m2: str = "  mov r12, 10\n"
    sys 1, 1, m2, 13
    lock m3: str = "  ; desugared: y+=1 -> inc r12\n"
    sys 1, 1, m3, 28
    lock m4: str = "  inc r12\n"
    sys 1, 1, m4, 10

task emit_footer():
    lock f: str = "  mov rax,60\n  xor rdi,rdi\n  syscall\n"
    sys 1, 1, f, 32

task core():
    lock v: str = "Stage 1: compiling pure_concise.dhar\n"
    sys 1, 1, v, 35
    flux fd: i32 = 0
    lock path: str = "tests/pure_concise.dhar"
    sys 2, path, 0, 0
    sysret fd
    flux buf: raw[256]
    flux n: i32 = 0
    sys 0, fd, buf, 256
    sysret n
    sys 3, fd, 0, 0
    emit_header()
    emit_inferred_var(10)
    emit_footer()
    lock done: str = "Stage 1: y=10 inferred OK\n"
    sys 1, 1, done, 25
