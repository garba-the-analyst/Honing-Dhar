task emit_header():
    lock h1: str = "section .text\n"
    sys 1, 1, h1, 14
    lock h2: str = "  global _start\n"
    sys 1, 1, h2, 16
    lock h3: str = "_start:\n"
    sys 1, 1, h3, 8
    lock h4: str = "  call core\n"
    sys 1, 1, h4, 12
    lock h5: str = "  mov rax,60\n"
    sys 1, 1, h5, 13
    lock h6: str = "  xor rdi,rdi\n"
    sys 1, 1, h6, 14
    lock h7: str = "  syscall\n"
    sys 1, 1, h7, 10
    lock h8: str = "core:\n"
    sys 1, 1, h8, 6

task handle_choose():
    lock c1: str = "  ; choose x:\n"
    sys 1, 1, c1, 14

task handle_is():
    lock i1: str = "  cmp r12, 1\n"
    sys 1, 1, i1, 13
    lock i2: str = "  jne .L_is_next\n"
    sys 1, 1, i2, 18
    lock i3: str = ".L_is_next:\n"
    sys 1, 1, i3, 13

task handle_each():
    lock e1: str = "  ; each y in buf\n"
    sys 1, 1, e1, 18

task handle_attempt():
    lock a1: str = "  ; attempt:\n"
    sys 1, 1, a1, 13

task core():
    lock v: str = "Stage 1: compiling all_new.dhar\n"
    sys 1, 2, v, 31
    flux fd: i32 = 0
    lock path: str = "/tmp/all_new.dhar"
    sys 2, path, 0, 0
    sysret fd
    when fd < 0:
        lock err: str = "  ; could not open\n"
        sys 1, 1, err, 21
    fallback:
        flux buf: raw[256]
        flux n: i32 = 0
        sys 0, fd, buf, 256
        sysret n
        sys 3, fd, 0, 0
        lock ok: str = "  ; read all_new.dhar\n"
        sys 1, 1, ok, 22
    emit_header()
    handle_choose()
    handle_is()
    handle_each()
    handle_attempt()
    lock f1: str = "  ret\n"
    sys 1, 1, f1, 6
    lock done: str = "Stage 1: all_new.dhar compiled\n"
    sys 1, 2, done, 29
