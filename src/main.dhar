task emit_header():
    lock h1: str = "section .text\n"
    sys 1, 1, h1, 14
    lock h2: str = "  global _start\n"
    sys 1, 1, h2, 16
    lock h3: str = "_start:\n"
    sys 1, 1, h3, 8
    lock h4: str = "  call core\n"
    sys 1, 1, h4, 12
    lock h5: str = "  mov rax,60\n"
    sys 1, 1, h5, 13
    lock h6: str = "  xor rdi,rdi\n"
    sys 1, 1, h6, 14
    lock h7: str = "  syscall\n"
    sys 1, 1, h7, 10
    lock h8: str = "core:\n"
    sys 1, 1, h8, 6

task emit_inferred_y():
    lock m1: str = "  mov r12, 10\n"
    sys 1, 1, m1, 14

task emit_footer():
    lock f1: str = "  ret\n"
    sys 1, 1, f1, 6

task core():
    lock v: str = "Stage 1: y=10 inferred OK\n"
    sys 1, 2, v, 25
    flux fd: i32 = 0
    lock path: str = "/home/garba-the-analyst/Desktop/Projects/honing-dhar/tests/pure_concise.dhar"
    sys 2, path, 0, 0
    sysret fd
    flux buf: raw[256]
    flux n: i32 = 0
    sys 0, fd, buf, 256
    sysret n
    sys 3, fd, 0, 0
    emit_header()
    emit_inferred_y()
    emit_footer()
