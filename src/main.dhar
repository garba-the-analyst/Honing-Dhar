task emit_header():
    lock hdr: str = "section .text\n  global _start\n_start:\n  call core\n"
    sys 1, 1, hdr, 41

task emit_footer():
    lock ftr: str = "  mov rax, 60\n  xor rdi, rdi\n  syscall\n"
    sys 1, 1, ftr, 32

task compile_concise(len: i32):
    lock m1: str = "Stage 1: desugar x=5 -> flux, x+=1, print\n"
    sys 1, 1, m1, 37
    give len

task core():
    lock v: str = "honing-dhar Stage 1 v0.5.0 self-hosting\n"
    sys 1, 1, v, 36
    emit_header()
    compile_concise(0)
    emit_footer()
    lock done: str = "Stage 1 emit complete\n"
    sys 1, 1, done, 22
