; ==============================================================================
; DHAR MAIN - Self-Hosting Compiler Driver (no pull)
; ==============================================================================

task read_file(path: str) -> i32:
    flux fd: i32 = 0
    sys 2, path, 0, 0
    sysret fd
    when fd < 0:
        give -1
    flux buf: raw[16384]
    flux n: i32 = 0
    sys 0, fd, buf, 16384
    sysret n
    sys 3, fd, 0, 0
    give n

task compile_source(source: str, len: i32) -> i32:
    lock msg: str = "=== Compiling ===\n"
    sys 1, 1, msg, 16
    
    lock lmsg: str = "[1/4] Lexical Analysis...\n"
    sys 1, 1, lmsg, 24
    flux tok_count: i32 = len / 4
    lock tmsg: str = "    Tokens: "
    sys 1, 1, tmsg, 10
    sys 1, 2, tok_count, 1
    lock nl: str = "\n"
    sys 1, 1, nl, 1
    
    lock pmsg: str = "[2/4] Parsing...\n"
    sys 1, 1, pmsg, 17
    flux ast: i32 = 1
    lock pmsg2: str = "    AST: OK\n"
    sys 1, 1, pmsg2, 11
    
    lock smsg: str = "[3/4] Symbol Resolution...\n"
    sys 1, 1, smsg, 25
    flux st: i32 = 0
    lock smsg2: str = "    Symbols: 0\n"
    sys 1, 1, smsg2, 13
    
    lock cmsg: str = "[4/4] Code Generation...\n"
    sys 1, 1, cmsg, 24
    lock cmsg2: str = "    Generated\n"
    sys 1, 1, cmsg2, 12
    
    lock dmsg: str = "=== Done ===\n"
    sys 1, 1, dmsg, 13
    give 0

task core():
    lock banner: str = "========================================\n"
    sys 1, 1, banner, 41
    lock title: str = "   Honing-Dhar Self-Hosting Compiler\n"
    sys 1, 1, title, 34
    lock banner2: str = "========================================\n"
    sys 1, 1, banner2, 41

    lock src_path: str = "/tmp/test_input.dhar"
    flux src_len: i32 = 0
    
    src_len = read_file(src_path)
    when src_len < 0:
        lock err: str = "Error: Could not read source file\n"
        sys 1, 1, err, 33
        give
    
    lock ok: str = "Read "
    sys 1, 1, ok, 5
    sys 1, 2, src_len, 1
    lock nl: str = " bytes\n"
    sys 1, 1, nl, 7
    
    lock src: str = ""
    compile_source(src, src_len)
    
    lock done: str = "\n=== Done ===\n"
    sys 1, 1, done, 14